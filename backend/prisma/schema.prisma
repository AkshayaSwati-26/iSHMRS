datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  PATIENT
}

enum BedStatus {
  Available
  Occupied
  Reserved
  Cleaning
  Maintenance
  TransferPending
}

enum BedType {
  General
  ICU
  Emergency
  Isolation
  Maternity
  OperationRecovery
}

enum OPDTokenStatus {
  Waiting
  InConsultation
  Completed
  Cancelled
  NoShow
}

enum OPDTokenPriority {
  Normal
  Emergency
  SeniorCitizen
  Pregnancy
}

enum AdmissionStatus {
  Admitted
  Discharged
  Transferred
}

enum InventoryTransactionType {
  StockIn
  StockOut
  StockTransfer
  StockAudit
}

enum AlertType {
  MedicineExpiry
  LowStock
  BedShortage
  EmergencyCase
  QueueOverflow
  HighOccupancy
  SystemError
}

enum AlertStatus {
  Active
  Acknowledged
  Resolved
}

enum Severity {
  Low
  Medium
  High
  Critical
}

enum ReportType {
  Daily
  Weekly
  Monthly
  Department
  BedUtilization
  MedicineConsumption
  PatientStats
  OPD_Performance
  Bed_Occupancy
  Inventory_Status
  Audit_Log
}

model Role {
  id          String    @id @default(uuid())
  name        RoleName  @unique
  users       User[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}

model Hospital {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  address     String?
  phone       String?
  users       User[]
  departments Department[]
  medicines   Medicine[]
  alerts      Alert[]
  syncs       HospitalSync[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  firstName             String                 @map("first_name")
  lastName              String                 @map("last_name")
  roleId                String                 @map("role_id")
  role                  Role                   @relation(fields: [roleId], references: [id])
  hospitalId            String?                @map("hospital_id")
  hospital              Hospital?              @relation(fields: [hospitalId], references: [id])
  notifications         Notification[]
  auditLogs             AuditLog[]
  transactions          InventoryTransaction[] @relation("CreatedBy")
  consultations         Consultation[]         @relation("DoctorConsultations")
  admissions            Admission[]            @relation("DoctorAdmissions")
  opdTokens             OPDToken[]             @relation("DoctorTokens")
  reports               Report[]               @relation("GeneratedBy")
  appointments          Appointment[]          @relation("DoctorAppointments")
  patientProfile        Patient?               @relation("PatientUser")
  generatedBills        Bill[]                 @relation("BillGeneratedBy")
  processedPayments     PaymentTransaction[]   @relation("PaymentProcessedBy")
  orderedLabOrders      LabOrder[]             @relation("LabOrderedBy")
  resultedLabItems      LabOrderItem[]         @relation("LabResultedBy")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
}

model Patient {
  id                    String                @id @default(uuid())
  uhid                  String                @unique
  name                  String
  age                   Int
  gender                String
  dateOfBirth           DateTime?             @map("date_of_birth")
  bloodGroup            String?               @map("blood_group")
  phone                 String?               @unique
  email                 String?               @unique
  address               String?
  emergencyContactName  String?               @map("emergency_contact_name")
  emergencyContactPhone String?               @map("emergency_contact_phone")
  isAdmitted            Boolean               @default(false) @map("is_admitted")
  // Patient portal user account link
  userId                String?               @unique @map("user_id")
  user                  User?                 @relation("PatientUser", fields: [userId], references: [id])
  // Relations
  histories             PatientHistory[]
  admissions            Admission[]
  opdTokens             OPDToken[]
  appointments          Appointment[]
  vitalLogs             PatientVitalLog[]
  symptomEntries        PatientSymptomEntry[]
  documents             PatientDocument[]
  feedbacks             PatientFeedback[]
  insuranceDetails      InsuranceDetails?
  familyProfiles        FamilyProfile[]
  medicationAdherence   MedicationAdherence[]
  bills                 Bill[]
  labOrders             LabOrder[]
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  deletedAt             DateTime?             @map("deleted_at")
}

model PatientHistory {
  id         String    @id @default(uuid())
  patientId  String    @map("patient_id")
  patient    Patient   @relation(fields: [patientId], references: [id])
  symptoms   String
  diagnosis  String
  vitals     Json?
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
}

model Department {
  id           String        @id @default(uuid())
  name         String
  hospitalId   String        @map("hospital_id")
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  wards        Ward[]
  admissions   Admission[]
  opdTokens    OPDToken[]
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model Ward {
  id           String     @id @default(uuid())
  name         String
  type         BedType
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  rooms        Room[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
}

model Room {
  id        String    @id @default(uuid())
  name      String
  wardId    String    @map("ward_id")
  ward      Ward      @relation(fields: [wardId], references: [id])
  beds      Bed[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model Bed {
  id         String      @id @default(uuid())
  label      String
  roomId     String      @map("room_id")
  room       Room        @relation(fields: [roomId], references: [id])
  status     BedStatus   @default(Available)
  type       BedType     @default(General)
  admissions Admission[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
}

model OPDToken {
  id           String           @id @default(uuid())
  tokenNumber  Int              @map("token_number")
  patientId    String           @map("patient_id")
  patient      Patient          @relation(fields: [patientId], references: [id])
  departmentId String           @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id])
  doctorId     String?          @map("doctor_id")
  doctor       User?            @relation("DoctorTokens", fields: [doctorId], references: [id])
  priority     OPDTokenPriority @default(Normal)
  status       OPDTokenStatus   @default(Waiting)
  calledAt     DateTime?        @map("called_at")
  completedAt  DateTime?        @map("completed_at")
  consultation Consultation?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
}

model Consultation {
  id                     String    @id @default(uuid())
  tokenId                String    @unique @map("token_id")
  token                  OPDToken  @relation(fields: [tokenId], references: [id])
  patientId              String    @map("patient_id")
  doctorId               String    @map("doctor_id")
  doctor                 User      @relation("DoctorConsultations", fields: [doctorId], references: [id])
  symptoms               String
  diagnosis              String
  vitals                 Json?
  prescriptions          Json?
  labRecommendations     Json?
  admissionRecommended   Boolean   @default(false) @map("admission_recommended")
  followUpDate           DateTime? @map("follow_up_date")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")
}

model Admission {
  id           String          @id @default(uuid())
  patientId    String          @map("patient_id")
  patient      Patient         @relation(fields: [patientId], references: [id])
  departmentId String          @map("department_id")
  department   Department      @relation(fields: [departmentId], references: [id])
  doctorId     String          @map("doctor_id")
  doctor       User            @relation("DoctorAdmissions", fields: [doctorId], references: [id])
  bedId        String          @map("bed_id")
  bed          Bed             @relation(fields: [bedId], references: [id])
  admittedAt   DateTime        @default(now()) @map("admitted_at")
  status       AdmissionStatus @default(Admitted)
  discharges   Discharge[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")
}

model Discharge {
  id           String    @id @default(uuid())
  admissionId  String    @map("admission_id")
  admission    Admission @relation(fields: [admissionId], references: [id])
  dischargedAt DateTime  @default(now()) @map("discharged_at")
  reason       String?
  summary      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
}

model Medicine {
  id                String                 @id @default(uuid())
  name              String
  genericName       String                 @map("generic_name")
  batchNumber       String                 @map("batch_number")
  manufacturer      String
  purchaseDate      DateTime               @map("purchase_date")
  expiryDate        DateTime               @map("expiry_date")
  unitPrice         Float                  @map("unit_price")
  stockQuantity     Int                    @map("stock_quantity")
  thresholdQuantity Int                    @map("threshold_quantity")
  hospitalId        String                 @map("hospital_id")
  hospital          Hospital               @relation(fields: [hospitalId], references: [id])
  transactions      InventoryTransaction[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  medicineId  String                   @map("medicine_id")
  medicine    Medicine                 @relation(fields: [medicineId], references: [id])
  quantity    Int
  type        InventoryTransactionType
  remarks     String?
  createdById String                   @map("created_by_id")
  createdBy   User                     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  deletedAt   DateTime?                @map("deleted_at")
}

model Alert {
  id         String      @id @default(uuid())
  type       AlertType
  status     AlertStatus @default(Active)
  message    String
  severity   Severity    @default(Medium)
  hospitalId String      @map("hospital_id")
  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
}

model HospitalSync {
  id           String    @id @default(uuid())
  hospitalId   String    @map("hospital_id")
  hospital     Hospital  @relation(fields: [hospitalId], references: [id])
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at")
  syncStatus   String    @map("sync_status")
  payload      Json?
  createdAt    DateTime  @default(now()) @map("created_at")
}

model Report {
  id            String     @id @default(uuid())
  title         String
  type          ReportType
  fileUrl       String?    @map("file_url")
  generatedById String     @map("generated_by_id")
  generatedBy   User       @relation("GeneratedBy", fields: [generatedById], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
}

enum AppointmentStatus {
  Scheduled
  Completed
  Cancelled
  NoShow
}

model Appointment {
  id                    String            @id @default(uuid())
  patientId             String            @map("patient_id")
  patient               Patient           @relation(fields: [patientId], references: [id])
  doctorId              String            @map("doctor_id")
  doctor                User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  departmentId          String            @map("department_id")
  department            Department        @relation(fields: [departmentId], references: [id])
  appointmentDate       DateTime          @map("appointment_date")
  timeSlot              String            @map("time_slot")
  status                AppointmentStatus @default(Scheduled)
  notes                 String?
  preConsultationForm   Json?             @map("pre_consultation_form")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
}

// ============================
// PATIENT PORTAL MODELS
// ============================

enum VitalType {
  BloodPressure
  BloodSugar
  Weight
  Temperature
  SpO2
  HeartRate
  Height
}

enum SymptomSeverity {
  Mild
  Moderate
  Severe
}

enum DocumentType {
  LabReport
  Radiology
  Prescription
  Insurance
  Discharge
  Other
}

model PatientVitalLog {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  patient     Patient   @relation(fields: [patientId], references: [id])
  type        VitalType
  value       Float
  value2      Float?    // For BP: diastolic
  unit        String
  notes       String?
  loggedAt    DateTime  @default(now()) @map("logged_at")
  createdAt   DateTime  @default(now()) @map("created_at")
}

model PatientSymptomEntry {
  id          String          @id @default(uuid())
  patientId   String          @map("patient_id")
  patient     Patient         @relation(fields: [patientId], references: [id])
  symptoms    String[]        // Array of symptom strings
  severity    SymptomSeverity @default(Mild)
  notes       String?
  loggedAt    DateTime        @default(now()) @map("logged_at")
  createdAt   DateTime        @default(now()) @map("created_at")
}

model PatientDocument {
  id          String       @id @default(uuid())
  patientId   String       @map("patient_id")
  patient     Patient      @relation(fields: [patientId], references: [id])
  name        String
  type        DocumentType @default(Other)
  fileUrl     String       @map("file_url")  // base64 data URI or cloud URL
  fileSize    Int?         @map("file_size")
  mimeType    String?      @map("mime_type")
  notes       String?
  uploadedAt  DateTime     @default(now()) @map("uploaded_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  deletedAt   DateTime?    @map("deleted_at")
}

model PatientFeedback {
  id              String   @id @default(uuid())
  patientId       String   @map("patient_id")
  patient         Patient  @relation(fields: [patientId], references: [id])
  consultationId  String?  @map("consultation_id")
  doctorId        String?  @map("doctor_id")
  hospitalId      String?  @map("hospital_id")
  rating          Int      // 1-5 stars
  comment         String?
  isAnonymous     Boolean  @default(false) @map("is_anonymous")
  npsScore        Int?     @map("nps_score")  // 0-10 Net Promoter Score
  createdAt       DateTime @default(now()) @map("created_at")
}

model InsuranceDetails {
  id             String    @id @default(uuid())
  patientId      String    @unique @map("patient_id")
  patient        Patient   @relation(fields: [patientId], references: [id])
  provider       String
  policyNumber   String    @map("policy_number")
  groupNumber    String?   @map("group_number")
  holderName     String    @map("holder_name")
  validFrom      DateTime  @map("valid_from")
  validTo        DateTime  @map("valid_to")
  coverageAmount Float?    @map("coverage_amount")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
}

model FamilyProfile {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  patient     Patient   @relation(fields: [patientId], references: [id])
  name        String
  relation    String    // Son, Daughter, Spouse, Parent, etc.
  age         Int?
  gender      String?
  bloodGroup  String?   @map("blood_group")
  phone       String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}

model MedicationAdherence {
  id             String    @id @default(uuid())
  patientId      String    @map("patient_id")
  patient        Patient   @relation(fields: [patientId], references: [id])
  medicineName   String    @map("medicine_name")
  dosage         String?
  scheduledTime  String    @map("scheduled_time")  // e.g. "08:00 AM"
  takenAt        DateTime? @map("taken_at")         // null = not taken yet
  isTaken        Boolean   @default(false) @map("is_taken")
  date           DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
}

// ============================
// BILLING & INVOICING MODELS
// ============================

enum BillStatus {
  Draft
  Generated
  Paid
  PartiallyPaid
  Cancelled
}

enum BillItemType {
  Consultation
  Bed
  Medicine
  Lab
  Procedure
  Other
}

enum PaymentMethod {
  Cash
  Card
  UPI
  Insurance
  NetBanking
}

model Bill {
  id             String               @id @default(uuid())
  billNumber     String               @unique @map("bill_number")
  patientId      String               @map("patient_id")
  patient        Patient              @relation(fields: [patientId], references: [id])
  admissionId    String?              @map("admission_id")
  consultationId String?              @map("consultation_id")
  hospitalId     String?              @map("hospital_id")
  status         BillStatus           @default(Generated)
  subtotal       Float
  taxAmount      Float                @default(0) @map("tax_amount")      // GST
  discountAmount Float                @default(0) @map("discount_amount")
  totalAmount    Float                @map("total_amount")
  paidAmount     Float                @default(0) @map("paid_amount")
  balanceAmount  Float                @map("balance_amount")
  notes          String?
  generatedById  String?              @map("generated_by_id")
  generatedBy    User?                @relation("BillGeneratedBy", fields: [generatedById], references: [id])
  items          BillItem[]
  payments       PaymentTransaction[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
}

model BillItem {
  id          String       @id @default(uuid())
  billId      String       @map("bill_id")
  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  type        BillItemType @default(Other)
  description String
  quantity    Int          @default(1)
  unitPrice   Float        @map("unit_price")
  totalPrice  Float        @map("total_price")
  createdAt   DateTime     @default(now()) @map("created_at")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  billId          String        @map("bill_id")
  bill            Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount          Float
  method          PaymentMethod @default(Cash)
  referenceNumber String?       @map("reference_number")
  notes           String?
  processedById   String        @map("processed_by_id")
  processedBy     User          @relation("PaymentProcessedBy", fields: [processedById], references: [id])
  processedAt     DateTime      @default(now()) @map("processed_at")
}

// ============================
// LAB & DIAGNOSTICS MODELS
// ============================

enum LabOrderStatus {
  Ordered
  SampleCollected
  Processing
  Resulted
  Cancelled
}

enum LabPriority {
  Routine
  Urgent
  STAT
}

model LabTest {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  category       String         // Hematology, Biochemistry, Radiology, Microbiology, Pathology
  sampleType     String?        @map("sample_type") // Blood, Urine, Swab, Tissue, X-Ray
  referenceRange String?        @map("reference_range")
  unit           String?
  price          Float          @default(0)
  hospitalId     String?        @map("hospital_id")
  items          LabOrderItem[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
}

model LabOrder {
  id             String         @id @default(uuid())
  orderNumber    String         @unique @map("order_number")
  patientId      String         @map("patient_id")
  patient        Patient        @relation(fields: [patientId], references: [id])
  consultationId String?        @map("consultation_id")
  admissionId    String?        @map("admission_id")
  orderedById    String         @map("ordered_by_id")
  orderedBy      User           @relation("LabOrderedBy", fields: [orderedById], references: [id])
  hospitalId     String?        @map("hospital_id")
  status         LabOrderStatus @default(Ordered)
  priority       LabPriority    @default(Routine)
  notes          String?
  items          LabOrderItem[]
  orderedAt      DateTime       @default(now()) @map("ordered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
}

model LabOrderItem {
  id                String       @id @default(uuid())
  labOrderId        String       @map("lab_order_id")
  labOrder          LabOrder     @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId         String       @map("lab_test_id")
  labTest           LabTest      @relation(fields: [labTestId], references: [id])
  sampleCollectedAt DateTime?    @map("sample_collected_at")
  resultValue       String?      @map("result_value")
  resultUnit        String?      @map("result_unit")
  isAbnormal        Boolean      @default(false) @map("is_abnormal")
  isCritical        Boolean      @default(false) @map("is_critical")
  resultNotes       String?      @map("result_notes")
  resultedAt        DateTime?    @map("resulted_at")
  resultedById      String?      @map("resulted_by_id")
  resultedBy        User?        @relation("LabResultedBy", fields: [resultedById], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
}

